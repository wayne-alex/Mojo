{
  "builds": [
    { "src": "config/wsgi.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "config/wsgi.py" }
  ],
  "crons": [
    { "path": "/api/internal/cron/auto-approve/",  "schedule": "0 * * * *" },
    { "path": "/api/internal/cron/release-holds/", "schedule": "0 * * * *" },
    { "path": "/api/internal/cron/purge-otps/", "schedule": "0 4 * * *" }
  ]
}